OPENROUTER_API_KEY=your_openrouter_api_key
# Who the agent works for (used in its prompt and on approvals).
RAHAT_PI_OWNER_NAME=Your Name
# IANA timezone for routines and daily caps; fixed-offset zones only (no daylight saving).
RAHAT_PI_TIMEZONE=UTC
RAHAT_PI_MODEL=anthropic/claude-sonnet-5.5
# Alternative: openai/gpt-5.4
RAHAT_PI_SUBAGENT_MODEL=anthropic/claude-haiku-5.5
# Optional; otherwise uses RAHAT_PI_SUBAGENT_MODEL.
# RAHAT_PI_SUMMARY_MODEL=anthropic/claude-haiku-5.5
# Summarize older history once the conversation reaches this size.
RAHAT_PI_COMPACT_AT_TOKENS=40000
RAHAT_PI_SUBAGENT_MAX_TOOL_CALLS=8
RAHAT_PI_SUBAGENT_MAX_MS=90000
RAHAT_PI_DATA_DIR=./data
RAHAT_PI_WEB_PORT=8787
RAHAT_PI_WORKSPACE_SHELL_TIMEOUT_MS=30000
# Per-message reservation cap; estimates are pessimistic and every step re-sends
# the whole chat, so web pages need room. Spend is still bounded by the USD caps.
RAHAT_PI_MAX_RUN_TOKENS=300000
# Thinking models count their thinking here too; 1024 cut off answers and summaries.
RAHAT_PI_MAX_OUTPUT_TOKENS=8000
RAHAT_PI_MAX_RUN_MS=120000
RAHAT_PI_MAX_TOOL_CALLS=20
RAHAT_PI_DAILY_USD_CAP=5
# Optional lifetime reservation cap for this data directory (unset by default).
# RAHAT_PI_TOTAL_USD_CAP=0.25
# Set to 1 only for offline faux-model demos.
RAHAT_PI_OFFLINE=0
